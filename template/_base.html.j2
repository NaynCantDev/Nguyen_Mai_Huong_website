<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}Portfolio{% endblock %} – {{ name }}</title>
<meta name="description" content="{{ short_bio }}">
<meta name="theme-color" content="#d4def5">
<link rel="preload" href="assets/fonts/bricolage-grotesque-vietnamese-standard-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="assets/style.css">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='%232c46c9'/><ellipse cx='26' cy='44' rx='11' ry='8' transform='rotate(-20 26 44)' fill='%23fff'/><rect x='34' y='12' width='5' height='32' fill='%23fff'/></svg>">
</head>
<body class="p-{{ page }}">
<a class="skip" href="#main">Bỏ qua đến nội dung</a>

<header class="top">
  <div class="wrap top-in">
    <a href="index.html" class="brand" aria-label="Trang chủ">
      <svg class="brand-note" viewBox="0 0 24 32" aria-hidden="true"><ellipse cx="9" cy="25" rx="7.5" ry="5.5" transform="rotate(-22 9 25)"/><rect x="14.6" y="2" width="2.6" height="22"/><path d="M17.2 2c3 2 6 4.5 5 9-1-3-3-4-5-4z"/></svg>
      <span>{{ name.split(' ')[-2:]|join(' ') }}</span>
    </a>
    <nav class="menu" aria-label="Chính">
      <a href="index.html"{{ ' aria-current="page"' if page == 'home' }}>Giới thiệu</a>
      <div class="has-sub">
        <a href="projects.html"{{ ' aria-current="page"' if page == 'projects' }}>Dự án</a>
        <button class="sub-btn" type="button" aria-expanded="false" aria-controls="subnav" aria-label="Mở danh sách 6 bài tập"><svg viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5l5 5 5-5"/></svg></button>
        <ul class="subnav" id="subnav">
          {% for pp in projects %}<li><a href="project-{{ pp.id }}.html"{{ ' aria-current="page"' if project is defined and project.id == pp.id }}><span>{{ pp.id }}</span>{{ pp.title }}</a></li>{% endfor %}
        </ul>
      </div>
      <a href="conclusion.html"{{ ' aria-current="page"' if page == 'conclusion' }}>Tổng kết</a>
    </nav>
  </div>
</header>

<main id="main">
{% block content %}{% endblock %}
</main>

<footer class="foot">
  <div class="wrap foot-in">
    <div class="foot-play">
      <p class="hand">chơi vài nốt trước khi đi nhé</p>
      <div class="piano" id="piano" role="group" aria-label="Đàn piano, bấm phím để chơi">
        {% set whites = ['C4','D4','E4','F4','G4','A4','B4','C5','D5','E5','F5','G5','A5','B5','C6'] %}
        {% set wkeys  = ['a','s','d','f','g','h','j','k','l',';',"'",'','','',''] %}
        {% set blacks = {'C4':'C#4','D4':'D#4','F4':'F#4','G4':'G#4','A4':'A#4','C5':'C#5','D5':'D#5','F5':'F#5','G5':'G#5','A5':'A#5'} %}
        {% set bkeys  = {'C#4':'w','D#4':'e','F#4':'t','G#4':'y','A#4':'u','C#5':'o','D#5':'p'} %}
        {% for n in whites %}
        <button class="k w" data-note="{{ n }}" data-kb="{{ wkeys[loop.index0] }}" aria-label="{{ n }}">{% if wkeys[loop.index0] %}<kbd>{{ wkeys[loop.index0]|upper }}</kbd>{% endif %}</button>
        {% if n in blacks %}{% set b = blacks[n] %}<button class="k b" data-note="{{ b }}" data-kb="{{ bkeys.get(b, '') }}" aria-label="{{ b }}" style="--at:{{ loop.index }}"></button>{% endif %}
        {% endfor %}
      </div>
      <p class="foot-tip">Bấm, kéo ngón tay qua các phím, hoặc gõ hàng phím A–' và W–P trên bàn phím.</p>
    </div>
    <dl class="foot-info">
      <div><dt>Sinh viên</dt><dd>{{ name }}</dd></div>
      <div><dt>Mã sinh viên</dt><dd>{{ student_id or 'đang cập nhật' }}</dd></div>
      {% if class %}<div><dt>Lớp</dt><dd>{{ class }}</dd></div>{% endif %}
      <div><dt>Ngành</dt><dd>{{ major }}</dd></div>
      <div><dt>Học phần</dt><dd>{{ subject }}</dd></div>
      {% if email %}<div><dt>Liên hệ</dt><dd><a href="mailto:{{ email }}">{{ email }}</a></dd></div>{% endif %}
    </dl>
  </div>
  <div class="wrap foot-end">{{ school }}</div>
</footer>
<script src="assets/main.js"></script>
</body>
</html>
